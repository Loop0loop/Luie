{
  "schemaVersion": 1,
  "profile": "darwin-arm64-apple-m4-local",
  "hardGate": false,
  "reason": "단일 호스트 절대 latency는 CI와 다른 장비의 부하 편차를 대표하지 않는다.",
  "correctnessGate": {
    "warmupCountPerScenario": 30,
    "sampleCountPerScenario": 200,
    "failureRate": 0,
    "requiresLatestDatabaseValue": true,
    "requiresExportedRevisionMatch": true,
    "requiresPackageArtifact": true
  },
  "localReviewP95UpperMs": {
    "world-single-commit-ack": 0.25,
    "world-100-burst-latest-merge": 0.6,
    "coordinator-main-core-dirty-barrier": 11,
    "cmd-ctrl-s-full-save": 13.5
  },
  "source": {
    "artifacts": [
      "docs/quality/save-latency-certification.json",
      "docs/quality/save-latency-e2e-certification.json"
    ],
    "runs": 3,
    "policy": "세 독립 실행의 bootstrap P95 95% CI 상한을 바깥쪽 0.05ms 또는 0.5ms로 올림한다. 초과는 회귀 조사 신호이며 자동 실패가 아니다."
  }
}
